# Environment variables for local Cloudflare Workers development
# Copy this file to .dev.vars and fill in your values

# Database connection string - use Neon for production
DATABASE_URL="postgresql://username:password@ep-example-123.eu-central-1.aws.neon.tech/database?sslmode=require"

# Optional: Override port for local development (defaults to 8787)
# PORT="8787"

# Optional: Set NODE_ENV
NODE_ENV="development"

MAX_GEMINI_CALLS=5
GEMINI_API_KEY=AI....

# PDF Export Configuration (required for Export PDF feature)
# Get your account ID from: Cloudflare Dashboard > Account > Account ID
# LOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
# Create an API token with Browser Rendering permissions
CF_BROWSER_RENDERING_TOKEN="your-cloudflare-api-token"
# Public URL of the deployed site (local dev won't work with Browser Rendering)
PUBLIC_URL="https://your-site.pages.dev"

# Semantius auth server (server-side)
AUTH_SERVER_API_KEY="your-auth-server-api-key"
SEMANTIUS_ORG="tests"

# Agentic Notebooks (Anthropic)
# Public demo mode uses user-provided keys from the browser UI.
# ANTHROPIC_API_KEY is optional and not used by default in this project.
# ANTHROPIC_API_KEY="sk-ant-..."
