// $schema: node_modules/wrangler/config-schema.json
{
  "name": "cube-server",
  "main": "src/worker.ts",
  "compatibility_date": "2024-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Plain config vars (non-sensitive)
  "vars": {
    "SEMANTIUS_ORG": "tests"
  },

  // Secrets (set via: wrangler secret put <KEY>)
  // AUTH_SERVER_API_KEY — set via: wrangler secret put AUTH_SERVER_API_KEY
  // DATABASE_URL        — set via: wrangler secret put DATABASE_URL
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}